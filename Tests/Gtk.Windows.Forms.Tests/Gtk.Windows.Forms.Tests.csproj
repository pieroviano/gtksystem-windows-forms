<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\GtkForms.snk</AssemblyOriginatorKeyFile>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>GtkTests</RootNamespace>
		<LangVersion>latest</LangVersion>
		<WarningsAsErrors>CS8618;CS8600;CS8601;CS8602;CS8604;CS8625;CS8605;</WarningsAsErrors>
		<NoWarn>CS0109;CS0414;CS0115;CS0618;CS8618;CS0659;IDE0130</NoWarn>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>true</EnableUnsafeUTF7Encoding>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\M.gif" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Include="..\..\Source\GTKSystem.Windows.Forms\Content\System.ComponentModel.cs" Link="Internals\System.ComponentModel.cs" />
	  <Compile Include="..\..\Source\GTKSystem.Windows.Forms\Content\System.Resources.ResourceManager.cs" Link="Internals\System.Resources.ResourceManager.cs" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\M.gif" />
	  <EmbeddedResource Include="SystemResources\compat_1_1.txt">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="SystemResources\compat_2_0.txt">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.0" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.1.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NUnit" Version="3.14.0" />
		<PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Samples\GTKSystemWinFormsApp11\GTKSystemWinFormsApp11.csproj" />
	  <ProjectReference Include="..\..\Samples\GtkWinFormsApp_Net8\GTKWinFormsApp.csproj" />
	  <ProjectReference Include="..\..\Source\GTKSystem.Drawing\GTKSystem.Drawing.csproj" />
	  <ProjectReference Include="..\..\Source\GTKSystem.Resources.Extensions\GTKSystem.Resources.Extensions.csproj" />
	  <ProjectReference Include="..\..\Source\GTKSystem.Windows.Forms\GTKSystem.Windows.Forms.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Internals\CommonDialogs\" />
	  <Folder Include="Converters\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
