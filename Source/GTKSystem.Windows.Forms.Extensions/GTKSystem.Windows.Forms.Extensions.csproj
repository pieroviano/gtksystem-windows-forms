<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
        <DisableImplicitFrameworkReferences Condition="'$(TargetFramework)'=='net462'">true</DisableImplicitFrameworkReferences>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <Authors>chenhongjin</Authors>
        <Company>chenhongjin</Company>
        <Copyright>438865652@qq.com，chenhongjin</Copyright>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageProjectUrl>https://www.gtkapp.com</PackageProjectUrl>
        <PackageReleaseNotes>
			C# interface cross-platform development component gtksystem-windows-forms
		</PackageReleaseNotes>
        <Title>GTK cross-platform winform interface component, compiled once, can run on windows, linux, macos platforms</Title>
        <Description>
			It is a cross-platform interface component developed based on GTK components and compatible with the native C# control winform interface.
			Use this component GTKSystem.Drawing to compile once and run across platforms windows\linux\macos.
			Update platform:
			https://www.gtkapp.com；
			https://gitee.com/easywebfactory/gtksystem-windows-forms；
			https://github.com/easywebfactory/gtksystem-windows-forms；
			This fork:
			https://github.com/pieroviano/gtksystem-windows-forms.git
		</Description>
        <WarningsAsErrors>CS8618;CS8600</WarningsAsErrors>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/pieroviano/gtksystem-windows-forms.git</RepositoryUrl>
        <PackAsTool>False</PackAsTool>
        <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <LangVersion>latest</LangVersion>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\GtkForms.snk</AssemblyOriginatorKeyFile>
        <NoWarn>$(NoWarn);NUnit2015;NUnit2017</NoWarn>
        <Nullable>enable</Nullable>
        <RootNamespace>System.Windows.Forms</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <DefineConstants>$(DefineConstants);GTKSystemWindowsForms</DefineConstants>
        <PackageId>Net4x.Gtk.Windows.Forms.Extensions</PackageId>
        <NoWarn>CS0436</NoWarn>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="System" Condition="'$(TargetFramework)'=='net462'" />
        <Reference Include="System.Core" Condition="'$(TargetFramework)'=='net462'" />
        <Reference Include="System.Data" Condition="'$(TargetFramework)'=='net462'" />
        <Reference Include="System.Drawing" Aliases="sd" Condition="'$(TargetFramework)'=='net462'" PrivateAssets="All" />
        <Reference Include="System.Linq" Condition="'$(TargetFramework)'=='net462'" />
        <Reference Include="System.Runtime.Serialization" Condition="'$(TargetFramework)'=='net462'" />
        <Reference Include="System.Xml" Condition="'$(TargetFramework)'=='net462'" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\GTKSystem.Drawing\GTKSystem.Drawing.csproj" />
        <ProjectReference Include="..\GTKSystem.Resources.Extensions\GTKSystem.Resources.Extensions.csproj" />
        <ProjectReference Include="..\GTKSystem.Windows.Forms\GTKSystem.Windows.Forms.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\README.en.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <None Include="..\..\README.md" Link="README.zh-HANS.md" Pack="true" PackagePath="\README.zh-HANS.md" />
        <None Include="..\licenses\LICENSE.txt" Pack="True" PackagePath="\" />
    </ItemGroup>
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
</Project>